# --- Bot ---
BOT_TOKEN=BOTFATHER_DAN_OLINGAN_TOKEN
TIMEZONE=Asia/Tashkent
DB_NAME=eslatbot.db

# --- Ovozni matnga aylantirish (uzbekvoice.ai / Mohir AI) ---
# Bo'sh qoldirsangiz ovozli xabarlar qabul qilinmaydi, bot ishlayveradi
MOHIR_API_KEY=

# --- Ovoz matnini AI bilan tahlil qilish (Google Gemini) ---
# Bo'sh qoldirsangiz oddiy (regex) tahlil ishlayveradi
GEMINI_API_KEY=

# --- Domen (serverda) ---
# Berilsa Caddy avtomatik HTTPS sertifikat oladi.
# Lokalda bo'sh qoldiring — http://localhost da ishlaydi.
DOMAIN=eslat.thesofmebel.uz

# --- Adminka (Django) ---
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=uzun_tasodifiy_maxfiy_kalit_yozing
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=eslat.thesofmebel.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://eslat.thesofmebel.uz
# HTTPS orqasida ishlaganda 1 qiling (domen bilan doim 1)
DJANGO_HTTPS=1
# Admin manzilini yashirish (ixtiyoriy): DJANGO_ADMIN_URL=boshqaruv-x7/
DJANGO_ADMIN_URL=admin/

# --- Birinchi ishga tushishda admin foydalanuvchi (docker) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=kuchli_parol_yozing
DJANGO_SUPERUSER_EMAIL=admin@example.com
